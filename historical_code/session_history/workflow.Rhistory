f_patch2 <- function(items, f_in, ncol =3, ...) {
library(patchwork)
for (i in 1:length(items)) {
assign(paste0('p',i), f_in(y = items[i],...))
}
exp_text <- paste(paste0('p', 1:length(items)), collapse = '+')
eval(parse(text = exp_text)) + plot_layout(ncol = ncol)
}
