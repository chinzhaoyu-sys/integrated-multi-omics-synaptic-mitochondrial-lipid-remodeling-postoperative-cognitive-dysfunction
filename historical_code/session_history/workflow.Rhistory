library(GOplot)
# 1. 使用GOplot包提供的示例数据：
# 首先就是富集分析的结果：
david <- EC$david
# 其次是差异分析的结果：
genelist <- EC$genelist
# 使用circle_dat函数将这两个结果整合到一起：
circ <- circle_dat(EC$david, EC$genelist)
# 使用chord_dat函数构造绘制弦图所需要的数据格式；
# EC中的genes是一个矩阵，包含gene ID和logFC值：
nrow(EC$genes)
EC$process %in% david$Term
chord <- chord_dat(data = circ, genes = EC$genes, process = EC$process)
# 绘图：
GOChord(chord,
space = 0.02,  # 弦与弦之间的空隙；
gene.order = 'logFC',   # 按照哪一列排序；
gene.space = 0.25, # gene名标签与整个图之间的空隙；
gene.size = 5,  # gene标签的大小；
)
View(circ)
EC$genes
View(EC)
data(EC)
View(EC)
